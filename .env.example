# ============================================================
# 知枢 Zhishu · 企业级 RAG 知识中枢
# 复制为 .env 后填入自己的 Key。不填也能跑（自动 mock 模式）。
# ============================================================

# ---------- LLM（OpenAI 兼容：阿里云百炼 / DeepSeek / OpenAI）----------
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=qwen-plus
LLM_SMALL_MODEL=qwen-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---------- Embedding（百炼 text-embedding-v3，1024 维）----------
EMBED_PROVIDER=openai_compatible
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
# 无网络时把 EMBED_PROVIDER 设为 hash：用确定性哈希向量跑通链路（无效果、仅可测）

# ---------- Rerank（百炼原生 rerank 接口）----------
RERANK_PROVIDER=dashscope
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=6

# ---------- 存储 ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=zhishu_chunks
# 降级开关：Milvus 不可用时设 local，用 numpy 暴力检索
VECTOR_BACKEND=milvus

DATABASE_URL=postgresql://zhishu:zhishu@localhost:5432/zhishu
# 降级开关：PG 不可用时设 sqlite
METADATA_BACKEND=postgres

REDIS_URL=redis://localhost:6379/0
ENABLE_CACHE=true
# 降级开关：Redis 不可用时设 memory
CACHE_BACKEND=redis

# ---------- 检索 ----------
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=20
FUSION_TOP_K=10
RRF_K=60
USE_QUERY_REWRITE=true
USE_HYDE=true

# ---------- 生成治理 ----------
REFUSE_THRESHOLD=0.35

# ---------- 服务 ----------
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
